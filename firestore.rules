rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Responsável = login com e-mail/Google. Sessões anônimas são as do PIN.
    function named() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // Dados completos da família: só o dono (nunca uma sessão de PIN).
    match /families/{uid} {
      function owner() { return named() && request.auth.uid == uid; }
      function valid() {
        return request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'state', 'updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.revision is int
          && request.resource.data.state is string
          && request.resource.data.state.size() < 850000
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    // Visão de UMA pessoa cuidada. O nome do documento é o hash do PIN:
    // só lê quem sabe o PIN; ninguém consegue listar os documentos.
    match /pinViews/{hash} {
      function validView() {
        let d = request.resource.data;
        return hash.matches('^[a-f0-9]{64}$')
          && d.keys().hasOnly(['ownerUid', 'elderId', 'state', 'applied', 'expiresAt', 'updatedAt'])
          && d.ownerUid == request.auth.uid
          && d.elderId is string && d.elderId.size() <= 100
          && d.state is string && d.state.size() < 900000
          && d.applied is list && d.applied.size() <= 100
          && d.expiresAt is int
          && d.expiresAt > request.time.toMillis()
          && d.expiresAt <= request.time.toMillis() + 91 * 86400000
          && d.updatedAt == request.time;
      }
      allow get: if signedIn() && (resource == null
        || resource.data.expiresAt > request.time.toMillis()
        || (named() && resource.data.ownerUid == request.auth.uid));
      allow list: if false;
      allow create: if named() && validView();
      allow update: if named() && resource.data.ownerUid == request.auth.uid && validView();
      allow delete: if named() && resource.data.ownerUid == request.auth.uid;
    }

    // Ações do idoso (dose confirmada, adiada, pedido de ajuda).
    // Quem tem o PIN só cria; apenas o responsável lê e apaga.
    match /pinActions/{hash}/items/{id} {
      function view() { return get(/databases/$(database)/documents/pinViews/$(hash)).data; }
      function validAction() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind', 'medId', 'time', 'status', 'reason', 'createdAt'])
          && d.createdAt == request.time
          && ((d.kind == 'help' && d.keys().hasOnly(['kind', 'createdAt']))
            || (d.kind == 'dose'
              && d.medId is string && d.medId.size() <= 100
              && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
              && d.status in ['ok', 'no', 'later']
              && (!('reason' in d) || (d.reason is string && d.reason.size() <= 200))));
      }
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/pinViews/$(hash))
        && view().expiresAt > request.time.toMillis()
        && validAction();
      allow get, list, delete: if named() && view().ownerUid == request.auth.uid;
      allow update: if false;
    }
  }
}
