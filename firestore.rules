rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && !('pinAccess' in request.auth.token);
      }
      function valid() {
        return request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'state', 'updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.revision is int
          && request.resource.data.state is string
          && request.resource.data.state.size() < 850000
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
    match /elderViews/{accessId} {
      function activePin() {
        let access = get(/databases/$(database)/documents/pinAccess/$(accessId)).data;
        return request.auth != null
          && request.auth.token.pinAccess == true
          && request.auth.token.accessId == accessId
          && request.auth.token.ownerUid == access.ownerUid
          && request.auth.token.elderId == access.elderId
          && request.auth.token.pinVersion == access.version
          && access.active == true
          && access.expiresAt > request.time.toMillis();
      }
      allow get: if activePin();
      allow list, write: if false;
    }
  }
}
